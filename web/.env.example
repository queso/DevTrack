# Required. PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://dev_track:dev_track@localhost:5432/dev_track

# Required. API key authenticating every /api/v1/* request (Authorization: Bearer
# <key> or X-Api-Key: <key>). The DevTrack CLI reads the same DEVTRACK_API_KEY.
DEVTRACK_API_KEY=devtrack-local-dev-key
# Exposed to the Next.js client so the dashboard's SWR fetcher can authenticate.
NEXT_PUBLIC_DEVTRACK_API_KEY=devtrack-local-dev-key

# Pino log level. Valid values: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Canonical site URL used for sitemap, robots.txt, and Open Graph metadata (default: http://localhost:3100)
SITE_URL=http://localhost:3100

# Allowed origin for CORS requests. Set to "*" for any origin, or a specific URL.
# Leave empty for same-origin only (default: "")
CORS_ORIGIN=

# Max API requests per minute per IP address (default: 60)
RATE_LIMIT_RPM=60

# --- Cloudflare Access (production only; leave unset for local dev) ---------
# When DevTrack runs behind a Cloudflare Zero Trust Access application, browser
# requests arrive with a signed `Cf-Access-Jwt-Assertion` header that the API
# verifies (see web/lib/cf-access.ts). Set BOTH to enable this path; when either
# is unset the JWT path is disabled and only API-key auth applies. These are
# PUBLIC identifiers (not secrets).
#   CF_ACCESS_TEAM_DOMAIN — the "<team>.cloudflareaccess.com" host (no scheme);
#     it is the <team> in your Zero Trust dashboard URL.
#   CF_ACCESS_AUD — the Access application's Application Audience (AUD) tag,
#     from Access → Applications → <app> → Overview → Application Audience.
# CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag
